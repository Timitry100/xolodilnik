# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Порт HTTP-сервера (по умолчанию 3000)
PORT=3000

# Публичный https-адрес Mini App для кнопки в Telegram
# В разработке — адрес ngrok, в продакшене — адрес VPS
APP_URL=

# ИИ для рецептов. Ключ получить бесплатно на https://openrouter.ai/keys
# (поддерживается любой OpenAI-совместимый API — укажи AI_BASE_URL)
AI_API_KEY=
AI_MODEL=deepseek/deepseek-chat:free
# AI_BASE_URL=https://openrouter.ai/api/v1

# API «Честного знака» (ЦРПТ) — данные из личного кабинета https://ismp.crpt.ru
# Без них используется фолбэк на открытые данные (Open Food Facts)
CRPT_CLIENT_ID=
CRPT_CLIENT_SECRET=
