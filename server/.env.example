# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Полностью отключить бота (останется только сайт).
# Ставь false, если не можешь подключить бота к Telegram (прокси/блокировки)
BOT_ENABLED=true

# Гостевой доступ: сайт работает в обычном браузере без Telegram-авторизации
ALLOW_GUEST=true

# Порт HTTP-сервера. 3001 — чтобы не конфликтовать с первым сайтом bobkoved.ru (он на 3000)
PORT=3001

# Публичный https-адрес Mini App для кнопки в Telegram
# В разработке — адрес ngrok, в продакшене — адрес VPS
APP_URL=

# ИИ для рецептов. Ключ получить бесплатно на https://openrouter.ai/keys
# (поддерживается любой OpenAI-совместимый API — укажи AI_BASE_URL)
AI_API_KEY=
AI_MODEL=deepseek/deepseek-chat:free
# AI_BASE_URL=https://openrouter.ai/api/v1

# API «Честного знака» (ЦРПТ) — данные из личного кабинета https://ismp.crpt.ru
# Без них используется фолбэк на открытые данные (Open Food Facts)
CRPT_CLIENT_ID=
CRPT_CLIENT_SECRET=

# Прокси для Telegram-бота. Нужен, если Telegram заблокирован (РФ) и бот
# не может подключиться к api.telegram.org.
#   SOCKS5:  socks5://логин:пароль@хост:порт
#   HTTP:    http://логин:пароль@хост:порт
# Прокси используется ТОЛЬКО ботом, остальной трафик сервера идёт напрямую.
TG_PROXY=
