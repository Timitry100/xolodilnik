# Пример: добавить сайт «Холодильник» в nginx на том же сервере (Windows).
#
# Порядок:
#   1. В панели DNS: A-запись app → статичный IP (уже сделано: app.bobkoved.ru → 95.181.213.106)
#   2. Выпустить сертификат Let's Encrypt через win-acme (см. инструкцию)
#   3. Вставить ЭТИ ДВА server-блока в секцию http { ... } файла nginx.conf
#      (обычно C:\nginx\conf\nginx.conf)
#   4. Проверь и перезагрузи:  nginx -t   →   nginx -s reload
#   5. Запусти сервер «Холодильника» (start.bat), затем открой https://app.bobkoved.ru
#   6. В server\.env укажи APP_URL=https://app.bobkoved.ru
#   7. Порт 3000 наружу НЕ открывай (всё ходит через nginx по 443).

# ---------- Блок 1: HTTP-порт 80 (редирект + проверка домена для win-acme) ----------
server {
    listen 80;
    server_name app.bobkoved.ru;

    # папка для проверки владения доменом (win-acme кладёт сюда временные файлы)
    location ^~ /.well-known/acme-challenge/ {
        default_type "text/plain";
        root C:/acme;            # файлы будут лежать в C:/acme/.well-known/acme-challenge/
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- Блок 2: HTTPS-порт 443 (само приложение) ----------
server {
    listen 443 ssl;
    http2 on;
    server_name app.bobkoved.ru;

    # Сертификаты, выпущенные win-acme (порядок файлов: certificate.pem, privkey.pem)
    ssl_certificate     C:/acme/certs/app.bobkoved.ru/certificate.pem;
    ssl_certificate_key C:/acme/certs/app.bobkoved.ru/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}

